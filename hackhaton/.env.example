# VayOBD — environment configuration
# Copy to .env and fill in your values. Never commit .env (it is gitignored).
# All variables use the VAYOBD_ prefix and are read by the backend on startup.
# Run scripts/setup-mac.sh (or setup-linux.sh / setup-windows.ps1) to generate
# .env automatically.

# ── Executor ──────────────────────────────────────────────────────────────────
# "fixture" — local dev/demo, no live hosts needed (default)
# "ssh"     — production, requires SSH_KEY + SSH_KNOWN_HOSTS below
VAYOBD_EXECUTOR=fixture

# ── Fleet SSH credentials (required when EXECUTOR=ssh) ────────────────────────
# Request via: https://vayio.atlassian.net/servicedesk/customer/portals
VAYOBD_SSH_KEY=/path/to/fleet_private_key
VAYOBD_SSH_KNOWN_HOSTS=/path/to/fleet_known_hosts

# ── Inventory ─────────────────────────────────────────────────────────────────
VAYOBD_INVENTORY_PATH=~/.cache/vayobd/ree-vehicle-configs
VAYOBD_INVENTORY_BRANCH=main

# ── Static SPA (production only) ──────────────────────────────────────────────
# Set after running `npm run build` in frontend/. Leave commented in dev mode
# (Vite serves the frontend separately on port 5173).
# VAYOBD_STATIC_DIR=./frontend/dist

# ── Tuning (optional — defaults shown) ────────────────────────────────────────
# VAYOBD_RUN_TIMEOUT_SECONDS=30
# VAYOBD_REFRESH_INTERVAL_SECONDS=1800
